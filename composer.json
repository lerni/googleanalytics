{
    "name": "lerni/silverstripe-tracking",
    "type": "silverstripe-vendormodule",
    "description": "Google Analytics, Tag Manager & Microsoft Clarity Tracking Module for Silverstripe",
    "keywords": [
        "Silverstripe",
        "Google Analytics",
        "Google Tag Manager",
        "Clarity",
        "Tracking"
    ],
    "homepage": "https://github.com/lerni/silverstripe-tracking",
    "license": "BSD-3-Clause",
    "authors": [{
        "name": "Lukas Erni",
        "homepage": "https://kraftausdruck.ch",
        "email": "le@kraftausdruck.ch"
    }],
    "require": {
        "silverstripe/framework": "^5.0",
        "silverstripe/cms": "^5.0"
    },
    "minimum-stability": "dev",
    "extra": {
        "installer-name": "tracking"
    },
    "support": {
        "issues": "https://github.com/lerni/silverstripe-tracking/issues"
    },
    "suggest": {
        "lerni/klaro-cookie-consent": "Silverstripe Klaro! Consent Manager"
    },
    "autoload": {
        "psr-4": {
            "Kraftausdruck\\": "src/kraftausdruck/"
        }
    },
    "replace": {
        "lerni/silverstripe-googleanalytics": "self.version"
    }
}
